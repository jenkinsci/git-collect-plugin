<?jelly escape-by-default='true'?>
<j:jelly xmlns:j="jelly:core" xmlns:f="/lib/form">
    <f:entry title="Repository Path" field="path" description="Relative path to the folder containing .git">
        <f:textbox />
    </f:entry>
    <f:entry title="Marked Commit / Branch" default="HEAD" field="markedCommit" description="Branch name (e.g. 'master') or SHA1. Defaults to HEAD.">
        <f:textbox />
    </f:entry>
    <f:entry title="Git remote name" default="origin" field="remote" description="Optional remote name, if is not defined we consider it as origin">
        <f:textbox />
    </f:entry>
    <f:entry title="Browser URL" field="browserUrl" description="Optional base URL for the changelog links, e.g. https://gerrithub.io/c/amarula/checks-jenkins. Leave empty to guess it from the remote.">
        <f:textbox />
    </f:entry>
    <f:dropdownDescriptorSelector title="Repository Browser" field="browser" descriptors="${descriptor.browserDescriptors}">
        <f:dropdownListBlock value="auto" title="(Auto)" selected="${instance.browser == null}"/>
    </f:dropdownDescriptorSelector>
    <f:entry field="changelog">
        <f:checkbox title="Include in changelog?" default="true"/>
    </f:entry>
</j:jelly>
